        </mxCell>
        <mxCell id="cron-list" value="• delays:check (15min) — stall/stop/GPS loss detection&#xa;• weather:check (30min) — weather advisories per waypoint&#xa;• invoices:generate (hourly) — PDF invoices for completed jobs&#xa;• proposals:auto-reject (hourly) — cancel expired 48h proposals&#xa;• deliveries:auto-complete (hourly) — finish stale jobs 48h&#xa;• negotiations:auto-close (daily) — close inactive 7d negotiations&#xa;• data:cleanup (daily) — purge old tracking/notifications/weather" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="1435" width="660" height="80" as="geometry"/>
