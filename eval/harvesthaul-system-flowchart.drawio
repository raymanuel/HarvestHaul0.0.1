        <mxCell id="p6-start" value="Start Trip&#xa;→ in_progress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="550" y="920" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p6-gps-stream" value="GPS Streaming&#xa;(every 15-30s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;" vertex="1" parent="1">
          <mxGeometry x="550" y="980" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p6-stop-seq" value="For Each Stop:" style="text;html=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="1030" width="140" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p6-arrived" value="1. Arrived&#xa;(geofence ≤500m)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;" vertex="1" parent="1">
          <mxGeometry x="550" y="1060" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p6-loaded" value="2. Loaded&#xa;(crop confirmed + photo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;" vertex="1" parent="1">
          <mxGeometry x="550" y="1120" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p6-delivered" value="3. Delivered&#xa;(receipt photo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;" vertex="1" parent="1">
          <mxGeometry x="550" y="1180" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p6-fuel" value="Fuel Logging&#xa;(liters, cost, odometer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;" vertex="1" parent="1">
          <mxGeometry x="550" y="1240" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p6-end" value="End Trip&#xa;→ awaiting_confirmation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#bf360c;" vertex="1" parent="1">
          <mxGeometry x="550" y="1300" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p6-delay" value="Delay Detection&#xa;(every 15min cron)&#xa;Stall / Stop / GPS Loss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="770" y="980" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p6-websocket" value="WebSocket Broadcast&#xa;(2s poll + 30s heartbeat)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;" vertex="1" parent="1">
          <mxGeometry x="770" y="1060" width="180" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p6-e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p6-accept" target="p6-start" parent="1"/>
        <mxCell id="p6-e2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p6-start" target="p6-gps-stream" parent="1"/>
        <mxCell id="p6-e3" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p6-gps-stream" target="p6-arrived" parent="1"/>
        <mxCell id="p6-e4" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p6-arrived" target="p6-loaded" parent="1"/>
        <mxCell id="p6-e5" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p6-loaded" target="p6-delivered" parent="1"/>
        <mxCell id="p6-e6" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p6-delivered" target="p6-fuel" parent="1"/>
        <mxCell id="p6-e7" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p6-fuel" target="p6-end" parent="1"/>
        <mxCell id="p6-e8" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" source="p6-gps-stream" target="p6-delay" parent="1"/>
        <mxCell id="p6-e9" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" source="p6-gps-stream" target="p6-websocket" parent="1"/>

        <!-- ============================================ -->
        <!-- PHASE 7: BUYER CONFIRMATION -->
        <!-- ============================================ -->
        <mxCell id="phase7-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="800" width="300" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="phase7-label" value="PHASE 7: Buyer Confirmation" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fillColor=#F3E5F5;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="810" width="220" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="p7-track" value="Buyer Tracks&#xa;Live GPS + ETA" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="940" y="860" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p7-confirm" value="Confirm Receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;" vertex="1" parent="1">
          <mxGeometry x="940" y="940" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p7-completed" value="Status: completed" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="940" y="1010" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p7-auto" value="Auto-Complete&#xa;(48h no confirmation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="940" y="1080" width="180" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="p7-e1" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p7-track" target="p7-confirm" parent="1"/>
        <mxCell id="p7-e2" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="p7-confirm" target="p7-completed" parent="1"/>
        <mxCell id="p7-e3" style="edgeStyle=orthogonalEdgeStyle;dashed=1;strokeColor=#c62828;" edge="1" source="p7-completed" target="p7-auto" parent="1"/>

        <!-- ============================================ -->
