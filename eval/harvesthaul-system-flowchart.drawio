        <mxCell id="p6-arrived" value="1. Arrived&#xa;Geofence ≤500m farm GPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#f9a825;" vertex="1" parent="1">
