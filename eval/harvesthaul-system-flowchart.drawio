        <mxCell id="phase6-label" value="PHASE 6: Delivery Execution (Driver PWA)&#xa;Per-stop: assigned→arrived→loaded→delivered" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fillColor=#E0F7FA;rounded=1;" vertex="1" parent="1">
