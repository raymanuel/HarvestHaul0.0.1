        <mxCell id="p6-accept" value="Driver Accepts Job&#xa;POST /driver/.../accept&#xa;Sets accepted_at" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;" vertex="1" parent="1">
