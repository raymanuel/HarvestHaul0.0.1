        <mxCell id="p8-fleet" value="Fleet Analytics&#xa;Revenue / KPL / Fuel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;" vertex="1" parent="1">
