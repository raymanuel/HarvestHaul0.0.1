        <mxCell id="p6-gps-stream" value="GPS Streaming (every 15s)&#xa;POST /driver/tracking/store&#xa;Accuracy filter: ≤500m&#xa;Dedup: 30s same coords" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;" vertex="1" parent="1">
