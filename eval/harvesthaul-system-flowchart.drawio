        <mxCell id="p8-invoice" value="Auto Invoice Generation&#xa;(hourly cron)&#xa;PDF + Email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00695c;" vertex="1" parent="1">
          <mxGeometry x="1310" y="1270" width="180" height="60" as="geometry"/>
