        <mxCell id="p8-mark-paid" value="Logistics Verifies&#xa;+ Marks Paid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffccbc;strokeColor=#bf360c;" vertex="1" parent="1">
          <mxGeometry x="1310" y="1140" width="180" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p8-status-paid" value="Status: paid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1310" y="1210" width="180" height="30" as="geometry"/>
