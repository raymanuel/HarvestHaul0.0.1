        <mxCell id="p8-confirm-qty" value="Farmer Confirms&#xa;Loaded Quantity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#7b1fa2;" vertex="1" parent="1">
          <mxGeometry x="1310" y="1070" width="180" height="50" as="geometry"/>
